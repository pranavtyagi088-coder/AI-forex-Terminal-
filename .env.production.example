# INSTITUTIONAL AI FOREX TERMINAL — PRODUCTION ENVIRONMENT TEMPLATE
ENVIRONMENT=production
DEBUG=false

# Security & Auth
API_AUTH_TOKEN=your-production-bearer-token-here
SECRET_KEY=your-production-256bit-secret-key-here

# Database (PostgreSQL 16 + Asyncpg)
DATABASE_URL=postgresql+asyncpg://prop_trader:your_secure_password@db:5432/forex_terminal

# Redis Pub/Sub Streaming
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Market Data (Twelve Data)
TWELVE_DATA_API_KEY=your-twelvedata-api-key

# AI Providers (Sidecar Advisory Only ≤ 15%)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
